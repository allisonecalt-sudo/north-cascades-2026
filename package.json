{
  "name": "north-cascades-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Allison + Erin — North Cascades Aug 16-20 2026. A high-end digital itinerary brochure.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:links": "node scripts/link-check.mjs",
    "check:links:net": "node scripts/link-check.mjs --net",
    "lint": "eslint \"src/**/*.ts\" && npm run check:privacy && npm run check:links",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" index.html"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
